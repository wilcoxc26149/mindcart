# Copy to .env and adjust. These override config/mindcart.yaml at runtime.

LLM_API_KEY=your_openai_api_key

COGNEE_API_URL=http://localhost:8000
TENANT_ID=admin

ENABLE_BACKEND_ACCESS_CONTROL=false
REQUIRE_AUTHENTICATION=false

# MindCart infra (docker compose). Host ports are offset from cognee_falkordb
# so both stacks can run while developing (project_memory stays on 5432/6379/6380).
CACHE_BACKEND=redis
CACHE_HOST=localhost
CACHE_PORT=6381

DB_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=cognee
DB_PASSWORD=cognee
DB_NAME=cognee

# Falkor graph — host publish 6382 maps to container 6379
GRAPH_DATABASE_PROVIDER=falkor
GRAPH_DATABASE_URL=localhost
GRAPH_DATABASE_PORT=6382

# Vectors in Postgres (pgvector); omit VECTOR_DB_* to reuse DB_* above
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5433
VECTOR_DB_NAME=cognee
VECTOR_DB_USERNAME=cognee
VECTOR_DB_PASSWORD=cognee
